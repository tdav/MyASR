<Window x:Class="MyASR.DownloadForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузка модели" Icon="/MyASR;component/icon.ico"
        Width="520" Height="340" MinWidth="390" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource PrimaryText}"
        UseLayoutRounding="True" FontFamily="Segoe UI" FontSize="14" Language="ru-RU">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ModelName" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" x:Name="StatusText" Margin="0,12,0,6" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"/>
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ProgressBar x:Name="DownloadBar" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center"
                         AutomationProperties.Name="Загрузка файлов модели"/>
            <TextBlock Grid.Column="1" x:Name="PercentageText" Margin="12,0,0,0" FontWeight="SemiBold"/>
        </Grid>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}"/>
                <TextBlock x:Name="LicenceText" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryText}"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="4" Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RetryButton" Content="_Повторить" Padding="14,5" Visibility="Collapsed"
                    Margin="0,0,8,0" Click="RetryClicked"/>
            <Button x:Name="CancelButton" Content="_Отмена" Padding="14,5" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
