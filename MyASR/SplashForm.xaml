<Window x:Class="MyASR.SplashForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Запуск MyASR" Icon="/MyASR;component/icon.ico"
        Width="488" Height="224" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" FontFamily="Segoe UI" Language="ru-RU"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Margin="4" CornerRadius="18" BorderThickness="1"
            BorderBrush="{DynamicResource BorderColor}" Background="{DynamicResource HeroBackground}">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                       Width="54" Height="54" Margin="0,0,14,0" AutomationProperties.Name="MyASR"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MyASR" FontSize="25" FontWeight="SemiBold"
                               Foreground="{DynamicResource HeroTitle}"/>
                    <TextBlock Text="Локальное распознавание речи" FontSize="14"
                               Foreground="{DynamicResource HeroText}"/>
                </StackPanel>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StageLabel" TextWrapping="Wrap" FontSize="14" VerticalAlignment="Bottom"
                           Foreground="{DynamicResource HeroTitle}" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Bottom"
                           x:Name="StageCount"
                           Foreground="{DynamicResource HeroText}" FontSize="14"
                           Typography.NumeralAlignment="Tabular"/>
            </Grid>
            <ProgressBar x:Name="StageProgress" Grid.Row="3" Minimum="0" Maximum="4" IsIndeterminate="True"
                         Height="6" AutomationProperties.Name="Готовность приложения"
                         Foreground="{DynamicResource MeterFill}" Background="{DynamicResource MeterTrack}">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track">
                            <Border CornerRadius="3" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                                    Background="{TemplateBinding Foreground}"/>
                            <Border x:Name="Sweep" CornerRadius="3" Visibility="Collapsed"
                                    Background="{TemplateBinding Foreground}">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform/>
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Offset="0.26" Color="Transparent"/>
                                        <GradientStop Offset="0.43" Color="White"/>
                                        <GradientStop Offset="0.57" Color="White"/>
                                        <GradientStop Offset="0.74" Color="Transparent"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="Sweep" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="SweepMotion">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sweep"
                                                Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                                From="-0.65" To="0.65" Duration="0:0:1.4" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="SweepMotion"/></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>
        </Grid>
    </Border>
</Window>
