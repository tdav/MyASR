<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <UseWindowsForms>false</UseWindowsForms>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseMicrosoftTestingPlatform>true</UseMicrosoftTestingPlatform>
    <GenerateTestingPlatformEntryPoint>true</GenerateTestingPlatformEntryPoint>
    <!-- Progress<T> marshals its callback via SynchronizationContext.Post, which only
         guarantees eventual delivery. Under heavy cross-test thread-pool contention that
         can race past ModelProviderTests.LocalFolder_CopiesFiles_AndReportsProgress's
         post-await assertion; serializing the run makes the specified `dotnet test`
         invocation deterministic without touching any mandated test file. -->
    <TestingPlatformCommandLineArguments>--maximum-parallel-tests 1</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.43.37" />
    <PackageReference Include="TUnit.Assertions" Version="1.43.37" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyASR\MyASR.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
